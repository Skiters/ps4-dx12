# Include only from the separate native-port project after backend/compiler libs.
get_filename_component(_guest_texture_port "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(shadps4_native_guest_textures STATIC "${CMAKE_CURRENT_LIST_DIR}/guest_texture_cache.cpp")
target_sources(shadps4_native_guest_textures PRIVATE "${CMAKE_CURRENT_LIST_DIR}/guest_image_readback.cpp")
target_sources(shadps4_native_guest_textures PRIVATE "${CMAKE_CURRENT_LIST_DIR}/memory_surface_provider.cpp")
target_compile_features(shadps4_native_guest_textures PUBLIC cxx_std_20)
target_compile_definitions(shadps4_native_guest_textures PRIVATE NDEBUG)
target_link_libraries(shadps4_native_guest_textures PUBLIC shadps4_native_d3d12)
add_executable(dx12-memory-surface-test "${CMAKE_CURRENT_LIST_DIR}/memory_surface_provider_test.cpp")
target_link_libraries(dx12-memory-surface-test PRIVATE shadps4_native_guest_textures)
add_test(NAME native_guest_memory_display COMMAND dx12-memory-surface-test)
add_executable(dx12-guest-texture-test "${CMAKE_CURRENT_LIST_DIR}/guest_texture_test.cpp")
target_link_libraries(dx12-guest-texture-test PRIVATE shadps4_native_guest_textures)
add_test(NAME guest_texture_hardware COMMAND dx12-guest-texture-test)
add_test(NAME guest_texture_1d_array_hardware COMMAND dx12-guest-texture-test 1d)
add_executable(dx12-guest-bc-test "${CMAKE_CURRENT_LIST_DIR}/guest_bc_test.cpp")
target_link_libraries(dx12-guest-bc-test PRIVATE shadps4_native_guest_textures)
add_test(NAME native_guest_bc_hardware COMMAND dx12-guest-bc-test)
add_executable(dx12-guest-image-write-test "${CMAKE_CURRENT_LIST_DIR}/guest_image_write_test.cpp")
target_link_libraries(dx12-guest-image-write-test PRIVATE shadps4_native_guest_textures)
add_test(NAME native_guest_image_writeback COMMAND dx12-guest-image-write-test)
add_test(NAME native_guest_volume_writeback COMMAND dx12-guest-image-write-test volume)
add_test(NAME native_guest_deep_volume_mips COMMAND dx12-guest-image-write-test deep-volume)
set(_guest_original_tiling "${CMAKE_CURRENT_BINARY_DIR}/original_tiling.spv")
add_custom_command(OUTPUT "${_guest_original_tiling}"
  COMMAND "${SHADPS4_GLSLANG_EXECUTABLE}"
    -V -S comp -DIS_MACRO_TILED=1 -DBITS_PER_PIXEL=32
    "${_guest_texture_port}/native-port/fixtures/ps4_tiling_reference.comp" -o "${_guest_original_tiling}"
  DEPENDS "${_guest_texture_port}/native-port/fixtures/ps4_tiling_reference.comp" VERBATIM)
add_executable(dx12-guest-detile-reference "${CMAKE_CURRENT_LIST_DIR}/guest_texture_detile_reference_test.cpp" "${_guest_original_tiling}")
target_link_libraries(dx12-guest-detile-reference PRIVATE shadps4_native_guest_textures shadps4_dxil_compiler)
set(_guest_mesa "${SHADPS4_MESA_CONVERTER_DLL}")
add_test(NAME guest_thin2d_original_detiler COMMAND dx12-guest-detile-reference "${_guest_original_tiling}" "${_guest_mesa}")
add_test(NAME guest_display2d_original_detiler COMMAND dx12-guest-detile-reference "${_guest_original_tiling}" "${_guest_mesa}" 10)
foreach(_depth_tile RANGE 0 4)
  add_test(NAME guest_depth${_depth_tile}_original_detiler COMMAND dx12-guest-detile-reference "${_guest_original_tiling}" "${_guest_mesa}" ${_depth_tile})
endforeach()
foreach(_msaa_bpp 4 8 16)
  if(_msaa_bpp EQUAL 4)
    set(_msaa_shader "${_guest_original_tiling}")
  else()
    math(EXPR _msaa_bits "${_msaa_bpp} * 8")
    set(_msaa_shader "${CMAKE_CURRENT_BINARY_DIR}/reference_msaa_${_msaa_bits}.spv")
    add_custom_command(OUTPUT "${_msaa_shader}"
      COMMAND "${SHADPS4_GLSLANG_EXECUTABLE}" -V -S comp -DIS_MACRO_TILED=1 -DBITS_PER_PIXEL=${_msaa_bits}
        "${_guest_texture_port}/native-port/fixtures/ps4_tiling_reference.comp" -o "${_msaa_shader}"
      DEPENDS "${_guest_texture_port}/native-port/fixtures/ps4_tiling_reference.comp" VERBATIM)
    target_sources(dx12-guest-detile-reference PRIVATE "${_msaa_shader}")
  endif()
  foreach(_msaa_tile 0 1 2 3 4 5 13 14)
    foreach(_samples 2 4 8 16)
      add_test(NAME guest_msaa_${_msaa_bpp}byte_tile${_msaa_tile}_${_samples}_reference COMMAND dx12-guest-detile-reference "${_msaa_shader}" "${_guest_mesa}" ${_msaa_tile} ${_samples} ${_msaa_bpp})
    endforeach()
  endforeach()
endforeach()

add_executable(dx12-guest-cmask-test "${CMAKE_CURRENT_LIST_DIR}/guest_cmask_test.cpp")
target_link_libraries(dx12-guest-cmask-test PRIVATE shadps4_native_guest_textures)
add_test(NAME native_guest_cmask_fast_clear COMMAND dx12-guest-cmask-test)
