#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,std430) buffer Output {uint values[];} result;
layout(set=0,binding=1,r32ui) uniform uimage2D target;
layout(set=0,binding=2) uniform texture2D input_image;
layout(set=0,binding=3) uniform sampler input_sampler;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    uint index=uint(pixel.y*8+pixel.x);
    uint sampled=uint(round(textureLod(sampler2D(input_image,input_sampler),(vec2(pixel)+0.5)/8.0,0.0).r*255.0));
    uint value=sampled+index*3u+7u;
    result.values[index]=value;
    imageStore(target,pixel,uvec4(value,0,0,0));
}
