set(fixture "${ROOT}/native launch fixture")
file(MAKE_DIRECTORY "${fixture}")
file(COPY "${HOST}" DESTINATION "${fixture}")
file(COPY "${CHILD}" DESTINATION "${fixture}")
get_filename_component(host_name "${HOST}" NAME)
get_filename_component(child_name "${CHILD}" NAME)
file(WRITE "${fixture}/native-core-path.txt" "${child_name}\n")
file(WRITE "${fixture}/eboot with spaces.bin" "launcher argument fixture; not a game")
execute_process(COMMAND "${fixture}/${host_name}" --game "${fixture}/eboot with spaces.bin"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 37)
    message(FATAL_ERROR "Native launcher forwarding failed: ${result}: ${output} ${errors}")
endif()
message(STATUS "Native launcher passes absolute game path with spaces and propagates child exit status")
