function(native_dxc_identity)
    get_filename_component(_dxc_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_filename_component(_dxc_root "${SHADPS4_DXC_INCLUDE_DIR}" DIRECTORY)
    set(SHADPS4_DXC_RUNTIME_DIR "${_dxc_root}/bin/x64" CACHE PATH "DXC compiler and validator runtime matching the configured SDK")
    file(READ "${_dxc_repo}/native-port/vendor/dxc-native.json" _dxc_manifest)
    foreach(_file dxcompiler.dll dxil.dll dxc.exe dxcapi.h)
        if(_file STREQUAL "dxcapi.h")
            set(_path "${SHADPS4_DXC_INCLUDE_DIR}/${_file}")
        else()
            set(_path "${SHADPS4_DXC_RUNTIME_DIR}/${_file}")
        endif()
        string(JSON _expected GET "${_dxc_manifest}" files "${_file}")
        file(SHA256 "${_path}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "Native DXC input differs from the pinned dependency: ${_path}")
        endif()
    endforeach()
endfunction()
