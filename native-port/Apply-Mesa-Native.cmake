file(LOCK "${MESA_SOURCE}/native-source-contract.lock" GUARD PROCESS TIMEOUT 60)
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${MESA_SOURCE}" OUTPUT_VARIABLE _revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT _revision STREQUAL "b628375fb1fd99476bfbaaa0532deb6fe3a6870e")
    message(FATAL_ERROR "Native Mesa source is not the pinned revision")
endif()
get_filename_component(_vendor "${MESA_PATCH}" DIRECTORY)
file(READ "${_vendor}/mesa-native.json" _manifest)
string(JSON _patch_sha GET "${_manifest}" patch_sha256)
string(JSON _header_sha GET "${_manifest}" linked_header_sha256)
file(SHA256 "${MESA_PATCH}" _expected)
file(SHA256 "${MESA_LINKED_HEADER}" _header_actual)
if(NOT _expected STREQUAL _patch_sha OR NOT _header_actual STREQUAL _header_sha)
    message(FATAL_ERROR "Native Mesa source inputs differ from the pinned manifest")
endif()
set(_previous "${MESA_SOURCE}/native-source-contract.patch")
if(EXISTS "${_previous}")
    file(SHA256 "${_previous}" _previous_sha)
    if(NOT _previous_sha STREQUAL _expected)
        execute_process(COMMAND git diff --binary --full-index HEAD
            WORKING_DIRECTORY "${MESA_SOURCE}" OUTPUT_FILE "${MESA_SOURCE}/native-applied.patch" COMMAND_ERROR_IS_FATAL ANY)
        file(SHA256 "${MESA_SOURCE}/native-applied.patch" _actual)
        if(NOT _previous_sha STREQUAL _actual)
            message(FATAL_ERROR "Generated Mesa source has changes outside its previous native contract")
        endif()
        execute_process(COMMAND git apply --reverse --check "${_previous}" WORKING_DIRECTORY "${MESA_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND git apply --reverse "${_previous}" WORKING_DIRECTORY "${MESA_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
endif()
execute_process(COMMAND git apply --reverse --check "${MESA_PATCH}" WORKING_DIRECTORY "${MESA_SOURCE}" RESULT_VARIABLE _already_applied OUTPUT_QUIET ERROR_QUIET)
if(NOT _already_applied EQUAL 0)
    execute_process(COMMAND git apply --check "${MESA_PATCH}" WORKING_DIRECTORY "${MESA_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND git apply "${MESA_PATCH}" WORKING_DIRECTORY "${MESA_SOURCE}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(COPY_FILE "${MESA_LINKED_HEADER}" "${MESA_SOURCE}/src/microsoft/spirv_to_dxil/spirv_to_dxil_linked.h" ONLY_IF_DIFFERENT)
execute_process(COMMAND git diff --binary --full-index HEAD
    WORKING_DIRECTORY "${MESA_SOURCE}" OUTPUT_FILE "${MESA_SOURCE}/native-applied.patch" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${MESA_SOURCE}/native-applied.patch" _actual)
if(NOT _expected STREQUAL _actual)
    message(FATAL_ERROR "Native Mesa applied source differs from the exact vendored patch")
endif()
file(COPY_FILE "${MESA_PATCH}" "${_previous}" ONLY_IF_DIFFERENT)
