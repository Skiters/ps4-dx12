+bool
+spirv_to_dxil_decode_bc(uint32_t format, uint32_t number,
+                       const uint8_t *source, size_t source_size,
+                       uint32_t width, uint32_t height,
+                       uint8_t *destination, size_t destination_size)
+{
+   if (!source || !destination || !width || !height || width > 16384 || height > 16384 ||
+       format < 35 || format > 41)
+      return false;
+   bool floating = format >= 38 && format <= 40;
+   if ((format <= 37 || format == 41) ? (number != 0 && number != 9) :
+       format == 40 ? (number != 0 && number != 1 && number != 7) :
+       (number != 0 && number != 1))
+      return false;
+   unsigned block_bytes = format == 35 || format == 38 ? 8 : 16;
+   unsigned pixel_bytes = floating ? 16 : 4;
+   unsigned columns = (width + 3) / 4, rows = (height + 3) / 4;
+   if (source_size < (size_t)columns * rows * block_bytes ||
+       destination_size < (size_t)width * height * pixel_bytes)
+      return false;
+   for (unsigned y = 0; y < rows; ++y) {
+      for (unsigned x = 0; x < columns; ++x) {
+         const uint8_t *block = source + ((size_t)y * columns + x) * block_bytes;
+         union { float floats[64]; uint8_t bytes[256]; } decoded;
+         switch (format) {
+         case 35: util_format_dxt1_rgba_unpack_rgba_8unorm(decoded.bytes, 16, block, block_bytes, 4, 4); break;
+         case 36: util_format_dxt3_rgba_unpack_rgba_8unorm(decoded.bytes, 16, block, block_bytes, 4, 4); break;
+         case 37: util_format_dxt5_rgba_unpack_rgba_8unorm(decoded.bytes, 16, block, block_bytes, 4, 4); break;
+         case 38:
+            if (number == 1) util_format_rgtc1_snorm_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            else util_format_rgtc1_unorm_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            break;
+         case 39:
+            if (number == 1) util_format_rgtc2_snorm_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            else util_format_rgtc2_unorm_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            break;
+         case 40:
+            if (number == 1) util_format_bptc_rgb_float_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            else util_format_bptc_rgb_ufloat_unpack_rgba_float(decoded.floats, 64, block, block_bytes, 4, 4);
+            break;
+         case 41: util_format_bptc_rgba_unorm_unpack_rgba_8unorm(decoded.bytes, 16, block, block_bytes, 4, 4); break;
+         }
+         for (unsigned row = 0; row < MIN2(4, height - y * 4); ++row)
+            memcpy(destination + ((size_t)(y * 4 + row) * width + x * 4) * pixel_bytes,
+                   decoded.bytes + row * 4 * pixel_bytes,
+                   MIN2(4, width - x * 4) * pixel_bytes);
+      }
+   }
+   return true;
+}
